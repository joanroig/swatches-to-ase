{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: Web (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: Web (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/web",
      "sourceMaps": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/web/**", "!**/node_modules/**"],
      "sourceMapPathOverrides": {
        "vite:///*": "${webRoot}/*",
        "webpack:///*": "${webRoot}/*",
        "webpack:///./*": "${webRoot}/*"
      }
    },
    {
      "name": "Run: Desktop (Electron Dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:desktop"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Dist: Desktop (Package App)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dist:desktop"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "npm: build:desktop",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run: Convert CLI",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "./src/index.ts"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Test: Unit (node --test)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Test: Unit Coverage",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:coverage"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Test: GUI (Playwright)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:gui"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Deploy: Web (PRODUCTION)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["deploy", "--only", "firestore,hosting:production,hosting:mirror-1,hosting:mirror-2"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "npm: build:web",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Deploy: Web (Prelive)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["deploy", "--only", "firestore,hosting:pre"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "npm: build:web",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Dev: Web (Vite + Chrome)",
      "configurations": ["Run: Web (Vite)", "Debug: Web (Chrome)"],
      "stopAll": true
    }
  ]
}
