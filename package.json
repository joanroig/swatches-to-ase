{
  "name": "palette-studio",
  "description": "Import, edit, and export palette files across Procreate Swatches, Adobe ASE, and other popular formats.",
  "version": "4.1.6",
  "main": "dist-electron/electron/main.js",
  "repository": "https://github.com/joanroig/palette-studio.git",
  "author": "Joan Roig <12451419+joanroig@users.noreply.github.com>",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf ./build && tsc -p tsconfig.build.json",
    "build:licenses": "node scripts/build-licenses.mjs",
    "convert": "npx tsx ./src/index.ts",
    "dev:web": "vite",
    "build:web": "npm run build:licenses && vite build",
    "preview:web": "vite preview",
    "build:android": "npm run build:web && npx cap sync android",
    "build:ios": "npm run build:web && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "dev:desktop": "concurrently -k \"npm run dev:web\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://localhost:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:desktop": "npm run build:web && tsc -p electron/tsconfig.json",
    "dist:desktop": "npm run build:desktop && electron-builder",
    "run:dev": "nodemon",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "npm run typecheck && node --test --import tsx",
    "test:coverage": "npm run typecheck && node --test --experimental-test-coverage --import tsx",
    "test:gui": "node scripts/ensure-playwright.mjs && playwright test",
    "lint": "eslint . --ext .ts",
    "format": "eslint . --ext .ts --fix",
    "format:staged": "lint-staged",
    "deps:update": "npx npm-check-updates -u && npm install",
    "version:bump": "node scripts/bump-version.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "color-convert": "^3.1.3",
    "color-namer": "^1.4.0",
    "eslint": "^10.8.1",
    "firebase": "^12.17.1",
    "husky": "^9.1.7",
    "jszip": "^3.10.1",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "procreate-swatches": "^0.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/color-convert": "^3.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "npm-check-updates": "^23.0.2",
    "sass": "^1.102.0",
    "tsx": "^4.23.12",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": "eslint --cache --fix"
  },
  "typings": "src/global.d.ts",
  "build": {
    "appId": "com.joanroig.palettestudio",
    "productName": "Palette Studio",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist-web/**",
      "assets/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "palette-studio-v${version}-macos-${arch}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "palette-studio-v${version}-macos-${arch}-installer.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "palette-studio-v${version}-windows-portable.${ext}"
    },
    "nsis": {
      "artifactName": "palette-studio-v${version}-windows-installer.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "palette-studio-v${version}-linux-amd64-portable.${ext}"
    },
    "deb": {
      "artifactName": "palette-studio-v${version}-linux-amd64-installer.${ext}"
    }
  }
}
